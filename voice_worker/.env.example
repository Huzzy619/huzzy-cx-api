# Kora CX voice worker configuration (separate deployable).

# Internal platform API
KORA_API_BASE_URL=http://localhost:8000/api/v1
VOICE_WORKER_TOKEN=replace-in-secret-manager

# LiveKit server credentials
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
VOICE_AGENT_NAME=kora-voice-agent

# Voice engine + defaults
VOICE_ENGINE=livekit
DEFAULT_LANGUAGE=en-NG
TOOL_TIMEOUT_SECONDS=8

# Optional self-hosted LLM (OpenAI-compatible). When set and the agent config
# uses this model id, the worker routes to this endpoint instead of LiveKit
# Inference.
CUSTOM_LLM_MODEL=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Optional self-hosted STT/TTS endpoints keyed by approved model id.
# transport is "openai_compatible" or "raw_audio".
# Example:
# CUSTOM_SPEECH_ENDPOINTS={"ncair1/yoruba-asr":{"base_url":"https://stt.example/v1","transport":"raw_audio","api_key":"..."},"ncair1/yoruba-tts":{"base_url":"https://tts.example/v1","transport":"raw_audio","api_key":"...","voice":"default"}}
CUSTOM_SPEECH_ENDPOINTS={}
