DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-in-secret-manager
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgresql://kora:kora@localhost:5432/kora
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_WEBHOOK_BASE_URL=http://localhost:8000

TELEPHONY_PROVIDER=mock
TELEPHONY_WEBHOOK_SECRET=mock-webhook-secret

AI_PROVIDER=
AI_MODEL=

VOICE_ENGINE_PROVIDER=livekit
VOICE_WORKER_TOKEN=replace-in-secret-manager

OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
